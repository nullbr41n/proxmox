# Copy to `.env` in this repo root and fill in. Never commit `.env`.
#   cp .env.example .env && $EDITOR .env
#   source .env

# --- typical lab bootstrap (01-cluster / CSI) ---
# export TF_VAR_proxmox_token_id="…"
# export TF_VAR_proxmox_token_secret="…"
# export TF_VAR_vm_rocky_password="…"

# --- 07-vpn: wg-easy admin UI (bcrypt). Generate with:
#   docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'YOUR_PASSWORD'
# Use single quotes so the shell does not expand `$` in the hash.
export TF_VAR_wg_easy_password_hash='$2y$10$REPLACE_WITH_BCRYPT_HASH'
